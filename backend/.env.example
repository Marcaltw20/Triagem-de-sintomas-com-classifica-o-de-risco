# Copie este arquivo para ".env" (na mesma pasta) e preencha o token.
OPENAI_API_KEY=coloque_seu_token_aqui

# Modo da conversa: "realtime" (voz->voz, resposta em < 1 s) ou "classico" (transcreve -> chat -> voz)
MODO_PADRAO=realtime
MODELO_REALTIME=gpt-realtime-mini
VOZ_REALTIME=marin
# Silêncio (ms) para considerar que o usuário terminou de falar (menor = mais rápido, mas pode cortar a fala)
SILENCIO_MS=600

# Modelos do modo clássico (pode trocar se quiser)
MODELO_CHAT=gpt-4o-mini
MODELO_TRANSCRICAO=gpt-4o-mini-transcribe
MODELO_VOZ=gpt-4o-mini-tts
VOZ=nova

# Tempo (segundos) que o usuário tem para medir a pressão no Omron
TEMPO_PRESSAO_S=120

# 1 = simula o Omron (para testar sem o aparelho); 0 = usa o HEM-7156T via Bluetooth
OMRON_SIMULADO=0

# Saturação (SpO2) medida no Galaxy Watch (app em ../relogio_spo2)
# Tempo (segundos) esperando o relógio enviar a medição
TEMPO_SPO2_S=90
# 1 = simula o relógio (para testar sem ele); 0 = espera o Galaxy Watch
SPO2_SIMULADO=0

# Valores padrão quando não há leitura (temperatura ainda não tem sensor)
SPO2_MANUAL=98
TEMP_MANUAL=36.5

# Os valores de tempo, simulação e SpO2/temperatura acima são só os iniciais: depois que algo é
# mudado na tela de configuração (engrenagem na identificação), vale o que está em backend/ajustes.json.

# Banco de dados MySQL do XAMPP (ligue o MySQL no XAMPP Control Panel; o banco é criado sozinho)
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=
DB_NOME=triagem_inteligente
# 1 = grava cada triagem no banco; 0 = não grava (também dá para mudar na tela de configuração)
SALVAR_NO_BANCO=1

# Câmera: confere que é a mesma pessoa do começo ao fim da triagem (também na tela de configuração)
USAR_CAMERA=1
# 1 = simula a câmera (modo de teste, sem webcam)
CAMERA_SIMULADA=0
# 0 = primeira webcam do computador
CAMERA_INDICE=0
# semelhança mínima (0.30 a 0.80) para reconhecer o titular quando ele volta
LIMIAR_CAMERA=0.40
# outra pessoa na frente por N segundos seguidos cancela a triagem
TEMPO_TROCA_S=3
# titular fora da frente da câmera por N segundos cancela a triagem (0 = nunca)
TEMPO_ABANDONO_S=10
